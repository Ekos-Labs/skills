 "lines": {
  "n1": [
   "narrator",
   "Everything we ever built had to be carried to the world."
  ],
  "n2a": [
   "narrator",
   "By voice."
  ],
  "n2b": [
   "narrator",
   "By paper."
  ],
  "n2c": [
   "narrator",
   "By wire."
  ],
  "n3": [
   "narrator",
   "Then everyone got a voice."
  ],
  "n4": [
   "narrator",
   "Now, anyone can build anything."
  ],
  "n5": [
   "narrator",
   "So the world has never been louder."
  ],
  "n6": [
   "narrator",
   "Building was never the hard part."
  ],
  "n7": [
   "narrator",
   "Being heard is."
  ],
  "j1": [
   "ekos",
   "Good morning. While you slept, I found fourteen companies hiring their first marketer."
  ],
  "n10": [
   "narrator",
   "The tools changed. The job never did."
  ],
  "n9": [
   "narrator",
   "It's time to be heard."
  ],
  "n11": [
   "narrator",
   "For a hundred years, we did it by hand."
  ],
  "n11b": [
   "narrator",
   "Door by door."
  ],
  "n11c": [
   "narrator",
   "Letter by letter."
  ],
  "n11d": [
   "narrator",
   "Post by post."
  ],
  "n12": [
   "narrator",
   "Now, the machines will carry it."
  ]
 },
 "bites": {
  "news": {
   "src": "LlSYwHePOmc",
   "in": 0.0,
   "out": 3.3,
   "text": "Extra, extra, read all about it!"
  },
  "nbc": {
   "src": "jWmI50D41tE",
   "in": 0.0,
   "out": 2.6,
   "text": ""
  },
  "og1": {
   "src": "Br2KSsaTzUc",
   "in": 238.75,
   "out": 244.1,
   "text": "When I started Ogilvy and Mather, New York, nobody had heard of us."
  },
  "og2": {
   "src": "Br2KSsaTzUc",
   "in": 254.6,
   "out": 261.05,
   "text": "Every four weeks, I sent personalized mailings to our new business prospects."
  },
  "og3": {
   "src": "Br2KSsaTzUc",
   "in": 269.25,
   "out": 270.62,
   "text": "That was how we grew."
  },
  "aol": {
   "src": "dudJjUU9Nhs",
   "in": 25.6,
   "out": 28.6,
   "text": "You've got mail."
  },
  "gv1": {
   "src": "9c6JzlSQ_QA",
   "in": 7.32,
   "out": 9.5,
   "text": "Attention is how nations were built."
  },
  "gv2": {
   "src": "9c6JzlSQ_QA",
   "in": 13.84,
   "out": 17.14,
   "text": "Attention is the singular asset of the human race."
  },
  "jh1": {
   "src": "1EXtvwTNAeE",
   "in": 12.88,
   "out": 17.76,
   "text": "Everybody in the world is now a programmer. This is the miracle of artificial intelligence."
  },
  "al1": {
   "src": "5MWT_doo68k",
   "in": 1167.62,
   "out": 1173.4,
   "text": "Hey, go do this task for my job, and it goes off and clicks around the internet and calls someone and looks at your files and does it."
  },
  "af1": {
   "src": "irdNqlytsLc",
   "in": 25.7,
   "out": 33.0,
   "text": "An AI sales development agent that proactively works leads by contacting customers, responding to their questions, and scheduling meetings."
  }
 },
